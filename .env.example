# Copy this file to .env and fill in your values
# Week 5: Fine-Tuning LLMs

# ── Required for Path A (Claude) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Required for Path B (Ollama) ─────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── HuggingFace (optional, needed for gated models like Llama-3) ─────────────
HF_TOKEN=your_huggingface_token_here

# ── Fine-tuning backend override (auto-detected if not set) ──────────────────
# FINETUNE_BACKEND=mlx   # force MLX (Mac Apple Silicon)
FINETUNE_BACKEND=hf    # force HF Transformers + TRL

# ── wandb (optional, for training monitoring) ────────────────────────────────
# WANDB_API_KEY=your_wandb_key_here
# WANDB_PROJECT=hw5-finetuning
